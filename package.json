{
  "name": "fantasy-capital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "slice": "tsx apps/slice/src/main.ts",
    "slice:interactive": "tsx apps/slice/src/main.ts --interactive",
    "experiments": "tsx packages/sim/src/experiments/run.ts",
    "experiments:smoke": "tsx packages/sim/src/experiments/run.ts --seasons 20 --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.0"
  }
}
